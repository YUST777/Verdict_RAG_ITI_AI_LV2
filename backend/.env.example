# Verdict RAG Backend Environment Settings
# Copy to .env in backend/ or root

# FastAPI server
PORT=8000
HOST=0.0.0.0
APP_NAME="Verdict RAG API"

# Local LLM (Ollama or llama.cpp OpenAI-compatible)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
MODEL_API_STYLE=ollama
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_NUM_PREDICT=384
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=4

# Vector Store
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=verdict_knowledge
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_K=5

# Optional Database & Security
DATABASE_URL=
RAG_API_KEY=
CORS_ORIGINS=*
