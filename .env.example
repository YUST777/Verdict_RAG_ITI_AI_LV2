# Verdict RAG local configuration. Copy to .env for local development.

NODE_ENV=development

# Public (required at build time for Next.js; set your production URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# FastAPI RAG service used by the Verdict mirror AI panel
RAG_API_URL=http://localhost:8000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Auth & Secrets (use strong random values in production)
JWT_SECRET=your_jwt_secret
DB_ENCRYPTION_KEY=32_byte_hex_string
BLIND_INDEX_SALT=32_byte_hex_string

# Optional query-history database (Supabase Pooling or Direct). Percent-encode
# special characters in the password, for example @ becomes %40.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (required for Docker; must match judge0/judge0.conf REDIS_PASSWORD)
REDIS_PASSWORD=yourredispassword

# Services (Docker Compose uses internal hostnames)
MIRROR_SERVICE_URL=http://verdict-mirror:3099
JUDGE0_URL=http://verdict-judge0-server:2358
