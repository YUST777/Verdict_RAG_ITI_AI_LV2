# GPU variant for NVIDIA cards such as the MX450. This uses glibc/CUDA because
# NVIDIA's CUDA runtime is not compatible with Alpine's musl libc.
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

ARG LLAMA_CPP_REF=b5999
RUN git clone --depth 1 --branch ${LLAMA_CPP_REF} https://github.com/ggml-org/llama.cpp.git /src
RUN cmake -S /src -B /build \
    -DCMAKE_BUILD_TYPE=Release \
    -DGGML_NATIVE=OFF \
    -DGGML_CUDA=ON \
    -DGGML_CUDA_F16=ON \
    -DLLAMA_BUILD_SERVER=ON \
    -DLLAMA_CURL=OFF \
    -DBUILD_SHARED_LIBS=OFF \
    && cmake --build /build --target llama-server -j$(nproc) \
    && install -Dm755 /build/bin/llama-server /opt/llama/bin/llama-server

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/llama/bin/llama-server /usr/local/bin/llama-server

ARG MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-Coder-3B-Instruct-GGUF/resolve/main/qwen2.5-coder-3b-instruct-q3_k_m.gguf?download=true
RUN mkdir -p /models \
    && curl -fL --retry 3 --retry-delay 3 -o /models/qwen2.5-coder-3b-instruct-q3_k_m.gguf "$MODEL_URL" \
    && test -s /models/qwen2.5-coder-3b-instruct-q3_k_m.gguf

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/llama-server"]
CMD ["--model", "/models/qwen2.5-coder-3b-instruct-q3_k_m.gguf", "--host", "0.0.0.0", "--port", "8080", "--ctx-size", "2048", "--threads", "8", "--n-gpu-layers", "16", "--flash-attn", "--parallel", "1"]
