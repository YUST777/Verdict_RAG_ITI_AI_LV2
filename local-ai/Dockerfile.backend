FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install -r requirements.txt
# Download Chroma's small ONNX embedding model while the image is built.
# The running backend is on an internal network and must never need internet
# just to embed a query.
RUN python -c "from chromadb.utils.embedding_functions import DefaultEmbeddingFunction; DefaultEmbeddingFunction()(['offline warmup'])"

COPY backend/app ./app
COPY backend/scripts ./scripts
COPY backend/data ./data
COPY backend/railway-entrypoint.sh ./railway-entrypoint.sh
RUN chmod +x ./railway-entrypoint.sh && mkdir -p /app/data/chroma

EXPOSE 8000
ENTRYPOINT ["/app/railway-entrypoint.sh"]
